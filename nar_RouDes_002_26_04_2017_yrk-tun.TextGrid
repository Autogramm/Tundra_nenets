            xmin = 41.19400657243013 
            xmax = 41.66161673462743 
            text = "" 
        intervals [26]:
            xmin = 41.66161673462743 
            xmax = 42.46701894033835 
            text = "I cross it." 
        intervals [27]:
            xmin = 42.46701894033835 
            xmax = 42.83792785086312 
            text = "" 
        intervals [28]:
            xmin = 42.83792785086312 
            xmax = 46.0267041236389 
            text = "I go out the other door." 
