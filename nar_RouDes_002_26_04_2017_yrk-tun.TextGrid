        intervals [2]:
            xmin = 0.8941146278232067 
            xmax = 2.2983378238785726 
            text = "I am standing behind the fence." 
        intervals [3]:
            xmin = 2.2983378238785726 
            xmax = 2.731867243395619 
            text = "" 
        intervals [4]:
            xmin = 2.731867243395619 
            xmax = 4.2288305354293545 
            text = "I am standing behind the fence." 
        intervals [5]:
            xmin = 4.2288305354293545 
            xmax = 5.942030639974609 
            text = "" 
        intervals [6]:
            xmin = 5.942030639974609 
            xmax = 11.123261233632412 
            text = "tbdThere are two reindeer." 
        intervals [7]:
            xmin = 11.123261233632412 
            xmax = 12.149010681898584 
            text = "" 
        intervals [8]:
            xmin = 12.149010681898584 
            xmax = 17.169087148092597 
            text = "I jump over the fence, away from the two reindeer." 
        intervals [9]:
            xmin = 17.169087148092597 
            xmax = 17.763274538499005 
            text = "" 
        intervals [10]:
            xmin = 17.763274538499005 
            xmax = 20.57092951297044 
            text = "After jumping, I continue walking." 
        intervals [11]:
            xmin = 20.57092951297044 
            xmax = 21.12494076826478 
            text = "" 
        intervals [12]:
            xmin = 21.12494076826478 
            xmax = 24.14394226415865 
            text = "I see a tall tower in front of me." 
        intervals [13]:
            xmin = 24.14394226415865 
            xmax = 24.542477001097854 
            text = "" 
        intervals [14]:
            xmin = 24.542477001097854 
            xmax = 26.18186672722468 
            text = "Its roof is pointed like a chum (tent)." 
        intervals [15]:
            xmin = 26.18186672722468 
            xmax = 26.91182925124392 
            text = "" 
        intervals [16]:
            xmin = 26.91182925124392 
            xmax = 30.31569631525552 
            text = "It has two windows and a door." 
        intervals [17]:
            xmin = 30.31569631525552 
            xmax = 30.67116072169672 
            text = "" 
        intervals [18]:
            xmin = 30.67116072169672 
            xmax = 32.03385579656608 
            text = "Its door has stairs (""its door is bestaired"")." 
        intervals [19]:
            xmin = 32.03385579656608 
            xmax = 32.52778214808051 
            text = "" 
        intervals [20]:
            xmin = 32.52778214808051 
            xmax = 33.80737169150678 
            text = "I walk up the stairs." 
        intervals [21]:
            xmin = 33.80737169150678 
            xmax = 34.17179220389024 
            text = "" 
        intervals [22]:
            xmin = 34.17179220389024 
            xmax = 35.40979262291494 
            text = "I go through the door." 
