    item [3]:
        class = "IntervalTier" 
        name = "eng" 
        xmin = 0 
        xmax = 80.17873015873016 
        intervals: size = 48 
        intervals [1]:
            xmin = 0 
            xmax = 1.2157666731263763 
            text = "We are standing on a flat, high place.
" 
        intervals [2]:
            xmin = 1.2157666731263763 
            xmax = 1.6594602287469886 
            text = "" 
        intervals [3]:
            xmin = 1.6594602287469886 
            xmax = 3.6586384552248483 
            text = "We look forward from a flat, high place.
" 
        intervals [4]:
            xmin = 3.6586384552248483 
            xmax = 4.233954444642337 
            text = "" 
        intervals [5]:
            xmin = 4.233954444642337 
            xmax = 6.185918053703498 
            text = "We saw a boat near the river." 
        intervals [6]:
            xmin = 6.185918053703498 
            xmax = 6.537715049647391 
            text = "" 
        intervals [7]:
            xmin = 6.537715049647391 
            xmax = 8.083600586329341 
            text = "We walked towards the boat." 
        intervals [8]:
            xmin = 8.083600586329341 
            xmax = 8.767984427577199 
            text = "" 
        intervals [9]:
            xmin = 8.767984427577199 
            xmax = 9.7043110859419 
            text = "We got to the boat." 
        intervals [10]:
            xmin = 9.7043110859419 
            xmax = 10.273114885433738 
            text = "" 
        intervals [11]:
            xmin = 10.273114885433738 
            xmax = 11.5361281818834 
            text = "We pulled the boat into the water." 
        intervals [12]:
            xmin = 11.5361281818834 
            xmax = 12.051421854974242 
            text = "" 
        intervals [13]:
            xmin = 12.051421854974242 
            xmax = 14.256126248624016 
            text = "We paddled across the river to the other side." 
        intervals [14]:
            xmin = 14.256126248624016 
            xmax = 15.276419865011633 
            text = "" 
        intervals [15]:
            xmin = 15.276419865011633 
            xmax = 16.612055652186797 
            text = "" 
        intervals [16]:
            xmin = 16.612055652186797 
            xmax = 18.132500825776425 
            text = "" 
        intervals [17]:
            xmin = 18.132500825776425 
            xmax = 21.912458963383695 
            text = "We walked downstream along the right bank." 
        intervals [18]:
            xmin = 21.912458963383695 
            xmax = 23.079868702558905 
            text = "" 
        intervals [19]:
            xmin = 23.079868702558905 
            xmax = 24.35676416666786 
            text = "We got to the bridge." 
        intervals [20]:
            xmin = 24.35676416666786 
            xmax = 25.401064828363502 
            text = "" 
        intervals [21]:
            xmin = 25.401064828363502 
            xmax = 28.898571785852784 
            text = "Before we got to the bridge, we decided this: we would swim under the bridge." 
        intervals [22]:
            xmin = 28.898571785852784 
            xmax = 29.132639175543186 
            text = "" 
        intervals [23]:
            xmin = 29.132639175543186 
            xmax = 30.343096302508222 
            text = "We swam under the bridge." 
        intervals [24]:
            xmin = 30.343096302508222 
            xmax = 31.8053447223216 
            text = "" 
        intervals [25]:
            xmin = 31.8053447223216 
            xmax = 37.42721499479702 
            text = "As we got closer to the shore, we noticed a tall tower with a pointed roof." 
        intervals [26]:
            xmin = 37.42721499479702 
            xmax = 37.64801612310476 
            text = "" 
        intervals [27]:
            xmin = 37.64801612310476 
            xmax = 44.29342778718135 
            text = "We went to the tower and when we got there, we climbed up to the roof by walking along the side and the wall." 
        intervals [28]:
            xmin = 44.29342778718135 
            xmax = 44.68876852477671 
            text = "" 
        intervals [29]:
            xmin = 44.68876852477671 
            xmax = 46.59447609543804 
            text = "From the roof we looked around." 
        intervals [30]:
            xmin = 46.59447609543804 
            xmax = 47.06349774066051 
            text = "" 
        intervals [31]:
            xmin = 47.06349774066051 
            xmax = 48.86174374937487 
            text = "After looking around, we went down." 
        intervals [32]:
            xmin = 48.86174374937487 
            xmax = 49.22384135299045 
            text = "" 
        intervals [33]:
            xmin = 49.22384135299045 
            xmax = 50.374811469167284 
            text = "Then we went down the stairs." 
        intervals [34]:
            xmin = 50.374811469167284 
            xmax = 50.60674187633982 
            text = "" 
        intervals [35]:
            xmin = 50.60674187633982 
            xmax = 60.451384845050654 
            text = "Then we went around the house on the left side and walked on the high flat place." 
        intervals [36]:
            xmin = 60.451384845050654 
            xmax = 60.789136994109704 
            text = "" 
        intervals [37]:
            xmin = 60.789136994109704 
            xmax = 63.1162611121264 
            text = "We moved slightly to the right and kept going." 
        intervals [38]:
            xmin = 63.1162611121264 
            xmax = 63.71597925982031 
            text = "" 
        intervals [39]:
            xmin = 63.71597925982031 
            xmax = 65.74318097786528 
            text = "We came to a fork in the river." 
        intervals [40]:
            xmin = 65.74318097786528 
            xmax = 66.25791643215197 
            text = "" 
        intervals [41]:
            xmin = 66.25791643215197 
            xmax = 69.54933571610073 
            text = "We decided to swim across to the cape." 
        intervals [42]:
            xmin = 69.54933571610073 
            xmax = 71.02487162557141 
            text = "" 
        intervals [43]:
            xmin = 71.02487162557141 
            xmax = 72.64648719680946 
            text = "We crossed the river by swimming." 
        intervals [44]:
            xmin = 72.64648719680946 
            xmax = 72.95443667666554 
            text = "" 
        intervals [45]:
            xmin = 72.95443667666554 
            xmax = 73.27875303541134 
            text = "" 
        intervals [46]:
            xmin = 73.27875303541134 
            xmax = 74.72380676134922 
            text = "We stopped at a fork at the cape." 
        intervals [47]:
            xmin = 74.72380676134922 
            xmax = 75.44271385192371 
