            xmax = 74.19067469805728 
            text = "" 
        intervals [42]:
            xmin = 74.19067469805728 
            xmax = 79.17389170597315 
            text = "Танця' сер' ха""мыв', тамна тяха' ядалъяв', сятаняю' сюртев." 
