        intervals [8]:
            xmin = 11.136651059726097 
            xmax = 12.888249726810606 
            text = "Тадтикахад тамна тяха' ядадм'." 
        intervals [9]:
            xmin = 12.888249726810606 
            xmax = 12.989279539294273 
            text = "" 
        intervals [10]:
            xmin = 12.989279539294273 
            xmax = 13.753251879813218 
            text = "Пям' манэ""ӈадм'." 
        intervals [11]:
            xmin = 13.753251879813218 
            xmax = 14.308692512460372 
            text = "" 
        intervals [12]:
            xmin = 14.308692512460372 
            xmax = 19.012223945162695 
            text = "Пям' сятаняӈы хэвувнада маха'няю яля' сер' сюртев." 
        intervals [13]:
            xmin = 19.012223945162695 
            xmax = 19.88550938038793 
            text = "" 
        intervals [14]:
            xmin = 19.88550938038793 
            xmax = 29.756325659468782 
            text = "Тикы' пуд яхам' таркахаюта нямна ӈохолырць мадав." 
        intervals [15]:
            xmin = 29.756325659468782 
            xmax = 30.47241800020542 
            text = "" 
        intervals [16]:
            xmin = 30.47241800020542 
            xmax = 31.8273382053644 
            text = "Тарка пыявна ӈадимядм'." 
        intervals [17]:
            xmin = 31.8273382053644 
            xmax = 32.42867742199467 
            text = "" 
        intervals [18]:
            xmin = 32.42867742199467 
            xmax = 36.89505548098072 
            text = "Тарка' пыям мада""махадани ӈани' ӈохолырць яха' няби таркам' мадав." 
        intervals [19]:
            xmin = 36.89505548098072 
            xmax = 37.39844184210171 
            text = "" 
        intervals [20]:
            xmin = 37.39844184210171 
            xmax = 38.92278620409282 
            text = "Яха' иканя халя"" танявы""." 
        intervals [21]:
            xmin = 38.92278620409282 
            xmax = 40.109859744789624 
            text = "" 
        intervals [22]:
            xmin = 40.109859744789624 
            xmax = 44.265352962405196 
            text = "Тикахад маха'няку' мэхэя тамна тяха' яда нэкалӈав." 
        intervals [23]:
            xmin = 44.265352962405196 
            xmax = 44.57688863322767 
            text = "" 
        intervals [24]:
            xmin = 44.57688863322767 
            xmax = 46.22017228887965 
            text = "ӈоб' ядадм', ядадм'." 
        intervals [25]:
            xmin = 46.22017228887965 
            xmax = 46.47347294041824 
            text = "" 
        intervals [26]:
            xmin = 46.47347294041824 
            xmax = 49.41040355360122 
            text = "Нерни няна пирця харадм' манэ""ӈадм'." 
        intervals [27]:
            xmin = 49.41040355360122 
            xmax = 49.79297353824845 
            text = "" 
        intervals [28]:
            xmin = 49.79297353824845 
            xmax = 52.30837030443722 
            text = "Пирця харад' сидя сидеранда си." 
        intervals [29]:
            xmin = 52.30837030443722 
            xmax = 52.66789640564513 
            text = "" 
        intervals [30]:
            xmin = 52.66789640564513 
            xmax = 55.23395216736595 
            text = "Танцянда таня, нёнда си таня." 
        intervals [31]:
            xmin = 55.23395216736595 
            xmax = 55.65804700006538 
            text = "" 
        intervals [32]:
            xmin = 55.65804700006538 
            xmax = 58.92745852851255 
            text = "Махалэйда тю""у' ня' мятрев' саблюй." 
        intervals [33]:
            xmin = 58.92745852851255 
            xmax = 60.62754202464235 
            text = "" 
        intervals [34]:
            xmin = 60.62754202464235 
            xmax = 62.97049862548479 
            text = "ӈаво' пирка""на"" нёнда син' тэвыв'." 
        intervals [35]:
            xmin = 62.97049862548479 
            xmax = 63.31767355386938 
            text = "" 
        intervals [36]:
            xmin = 63.31767355386938 
            xmax = 65.30320161430365 
            text = "Танця' сер тю""у' танэяв'." 
        intervals [37]:
