    item [3]:
        class = "IntervalTier" 
        name = "eng" 
        xmin = 0 
        xmax = 89.2687074829932 
        intervals: size = 49 
        intervals [1]:
            xmin = 0 
            xmax = 0.9798565811038756 
            text = "" 
        intervals [2]:
            xmin = 0.9798565811038756 
            xmax = 6.359538183933236 
            text = "I walked through the gate, turned left and walked on." 
        intervals [3]:
            xmin = 6.359538183933236 
            xmax = 6.711861968703998 
            text = "" 
        intervals [4]:
            xmin = 6.711861968703998 
            xmax = 7.501471029118209 
            text = "I'm going in that direction." 
        intervals [5]:
            xmin = 7.501471029118209 
            xmax = 8.269110099093735 
            text = "" 
        intervals [6]:
            xmin = 8.269110099093735 
            xmax = 10.6895760887383 
            text = "I crossed the river on the bridge. " 
        intervals [7]:
            xmin = 10.6895760887383 
            xmax = 11.136651059726097 
            text = "" 
        intervals [8]:
            xmin = 11.136651059726097 
            xmax = 12.888249726810606 
            text = "Then I walked on." 
        intervals [9]:
            xmin = 12.888249726810606 
            xmax = 12.989279539294273 
            text = "" 
        intervals [10]:
            xmin = 12.989279539294273 
            xmax = 13.75225108588052 
            text = "I saw a tree." 
        intervals [11]:
            xmin = 13.75225108588052 
            xmax = 14.308692512460372 
            text = "" 
        intervals [12]:
            xmin = 14.308692512460372 
            xmax = 19.012223945162695 
            text = "I walked around the tree from left to right, following the course of the sun." 
        intervals [13]:
            xmin = 19.012223945162695 
            xmax = 19.885228263859503 
            text = "" 
        intervals [14]:
            xmin = 19.885228263859503 
            xmax = 29.756325659468782 
            text = "Then I crossed the river by swimming along where it forks." 
        intervals [15]:
            xmin = 29.756325659468782 
            xmax = 30.47241800020542 
            text = "" 
        intervals [16]:
            xmin = 30.47241800020542 
            xmax = 31.8273382053644 
            text = "I ended up on a headland at the fork of the river." 
        intervals [17]:
            xmin = 31.8273382053644 
            xmax = 32.42867742199467 
            text = "" 
        intervals [18]:
            xmin = 32.42867742199467 
            xmax = 36.89505548098072 
            text = "After crossing the headland at the fork, I swam back across the other branch of the river." 
        intervals [19]:
            xmin = 36.89505548098072 
            xmax = 37.39844184210171 
            text = "" 
        intervals [20]:
            xmin = 37.39844184210171 
            xmax = 38.92278620409282 
            text = "Apparently there were fish in the river." 
        intervals [21]:
            xmin = 38.92278620409282 
            xmax = 40.110488779187214 
            text = "" 
        intervals [22]:
            xmin = 40.110488779187214 
            xmax = 44.265352962405196 
            text = "Then I turned slightly to the right and kept going." 
        intervals [23]:
            xmin = 44.265352962405196 
            xmax = 44.57688863322767 
            text = "" 
        intervals [24]:
            xmin = 44.57688863322767 
            xmax = 46.22017228887965 
            text = "I'm still going, I'm still going." 
        intervals [25]:
            xmin = 46.22017228887965 
            xmax = 46.473519881830164 
            text = "" 
        intervals [26]:
            xmin = 46.473519881830164 
            xmax = 49.41040355360122 
            text = "In front of me I saw a high house." 
        intervals [27]:
            xmin = 49.41040355360122 
            xmax = 49.792610603745615 
            text = "" 
        intervals [28]:
            xmin = 49.792610603745615 
            xmax = 52.30837030443722 
            text = "The tower has two windows." 
        intervals [29]:
            xmin = 52.30837030443722 
            xmax = 52.66269312849442 
            text = "" 
        intervals [30]:
            xmin = 52.66269312849442 
            xmax = 55.23395216736595 
            text = "It has a staircase, it has a door." 
        intervals [31]:
            xmin = 55.23395216736595 
            xmax = 55.65804700006538 
            text = "" 
        intervals [32]:
            xmin = 55.65804700006538 
            xmax = 58.92745852851255 
            text = "Its roof is pointed up like a chum (tent)." 
        intervals [33]:
            xmin = 58.92745852851255 
            xmax = 60.62754202464235 
            text = "" 
        intervals [34]:
            xmin = 60.62754202464235 
            xmax = 62.97049862548479 
            text = "At one point I reached the door." 
        intervals [35]:
            xmin = 62.97049862548479 
            xmax = 63.31767355386938 
            text = "" 
        intervals [36]:
            xmin = 63.31767355386938 
            xmax = 65.30320161430365 
            text = "I went up the stairs." 
        intervals [37]:
            xmin = 65.30320161430365 
            xmax = 68.6291001372461 
            text = "" 
        intervals [38]:
            xmin = 68.6291001372461 
            xmax = 71.07431058352917 
            text = "I went inside the tower." 
        intervals [39]:
            xmin = 71.07431058352917 
            xmax = 71.27420329344046 
            text = "" 
        intervals [40]:
            xmin = 71.27420329344046 
            xmax = 73.97456575520337 
            text = "On the other side I went out through another door." 
        intervals [41]:
            xmin = 73.97456575520337 
            xmax = 74.19067469805728 
            text = "" 
        intervals [42]:
            xmin = 74.19067469805728 
            xmax = 79.17389170597315 
            text = "I went down the stairs, started walking and turned left.
" 
        intervals [43]:
            xmin = 79.17389170597315 
            xmax = 79.52379801094219 
            text = "" 
        intervals [44]:
            xmin = 79.52379801094219 
            xmax = 82.85649982147008 
            text = "I turned left and walked on." 
        intervals [45]:
            xmin = 82.85649982147008 
            xmax = 83.11937432576643 
            text = "" 
        intervals [46]:
            xmin = 83.11937432576643 
            xmax = 85.80373172803718 
            text = "I saw another unfamiliar fence." 
        intervals [47]:
            xmin = 85.80373172803718 
            xmax = 86.3387574292234 
            text = "" 
        intervals [48]:
            xmin = 86.3387574292234 
            xmax = 88.42998881807424 
            text = "Two deer appeared to be behind the fence.
" 
        intervals [49]:
            xmin = 88.42998881807424 
