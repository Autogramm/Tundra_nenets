    item [2]:
        class = "IntervalTier" 
        name = "yrk" 
        xmin = 0 
        xmax = 76.47492063492064 
        intervals: size = 34 
        intervals [1]:
            xmin = 0 
            xmax = 6.31152799269745 
            text = "Сэв""ни ӈадимб' яха' тарка' пыяхана мэвэдм'." 
        intervals [2]:
            xmin = 6.31152799269745 
            xmax = 7.252978857755273 
            text = "" 
        intervals [3]:
            xmin = 7.252978857755273 
            xmax = 13.786436370994394 
            text = "Яха' тарка' пыяхад тодо' яха"" сырӈадм': сятаня' сырӈадм', маханя' сырӈадм'." 
        intervals [4]:
            xmin = 13.786436370994394 
            xmax = 14.791646244759205 
            text = "" 
        intervals [5]:
            xmin = 14.791646244759205 
            xmax = 17.243241615687744 
            text = "Маханяӈэюм' таркамда ӈохолё мада таслав." 
        intervals [6]:
            xmin = 17.243241615687744 
            xmax = 19.831828129795312 
            text = "" 
        intervals [7]:
            xmin = 19.831828129795312 
            xmax = 22.311253486072165 
            text = "ӈохолё мадав, яда нэкалӈав." 
        intervals [8]:
            xmin = 22.311253486072165 
            xmax = 23.079495938792512 
            text = "" 
        intervals [9]:
            xmin = 23.079495938792512 
            xmax = 24.86049107010977 
            text = "Ядадм', ядадм', ядадм'." 
        intervals [10]:
            xmin = 24.86049107010977 
            xmax = 26.83090942539369 
            text = "" 
        intervals [11]:
            xmin = 26.83090942539369 
            xmax = 31.499394049218246 
            text = "ӈоб' ядадм', ӈоб' ядадм', нерни няна пирця махалэйтана харадм' манэ""ӈадм'." 
        intervals [12]:
            xmin = 31.499394049218246 
            xmax = 31.92466280962775 
            text = "" 
        intervals [13]:
            xmin = 31.92466280962775 
            xmax = 37.499210771906 
            text = "Маханяӈы хэвувнанда хаяма', ядувнанда — харданда пя ядувна тю""у' танэйв""." 
        intervals [14]:
            xmin = 37.499210771906 
            xmax = 37.87006486964942 
            text = "" 
        intervals [15]:
            xmin = 37.87006486964942 
            xmax = 38.95409992459173 
            text = "Махалэянда ни' танэйв""." 
        intervals [16]:
            xmin = 38.95409992459173 
            xmax = 39.72327879398549 
            text = "" 
        intervals [17]:
            xmin = 39.72327879398549 
            xmax = 42.00459948190421 
            text = "Махалэянда нид я""амна сырӈадм'." 
        intervals [18]:
            xmin = 42.00459948190421 
            xmax = 44.52832896620016 
            text = "" 
        intervals [19]:
            xmin = 44.52832896620016 
            xmax = 46.17780882668018 
            text = "Тадтикахад таси' ха""мыв""." 
        intervals [20]:
            xmin = 46.17780882668018 
            xmax = 46.85037644263503 
            text = "" 
        intervals [21]:
            xmin = 46.85037644263503 
            xmax = 49.84955054495755 
            text = "Таси' ха""ам""махадани нэкалӈав тамна тяха нэкалӈав." 
        intervals [22]:
            xmin = 49.84955054495755 
            xmax = 50.875838213217655 
            text = "" 
        intervals [23]:
            xmin = 50.875838213217655 
            xmax = 53.93926832073089 
            text = "ӈохолырць яхам' пул' ӈыламна мадав." 
        intervals [24]:
            xmin = 53.93926832073089 
            xmax = 54.423427579368834 
            text = "" 
        intervals [25]:
            xmin = 54.423427579368834 
            xmax = 55.33501780151785 
            text = "Таханяю' тэвыв'." 
